        <mxCell id="title" value="(e) Testing with reference-guided styles" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#202020;">
          <mxGeometry x="64" y="28" width="2752" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Reference image → pretrained B → learned E → G → generated word · the target transcript need not match the reference transcript" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="88" width="2752" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="C1: global/local E   ·   C2: content-first fusion   ·   C3: StrokePatchD/crops   |   Solid: forward   ·   Dashed: loss/target   ·   Green: global-style conditioning" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1272" width="2752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="explain-0" value="A learned global/local representation, not a reference-length rule" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#202020;">
          <mxGeometry x="64" y="1320" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="explain-1" value="B supplies multiscale visual evidence. E separates global pooled style from local residual evidence. During deterministic evaluation, g = mu_g; the seven local tokens are always deterministic. Reference text labels and writer IDs are not inputs to this inference path." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1367" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="explain-2" value="g = μ&lt;sub&gt;g&lt;/sub&gt;(B(x&lt;sub&gt;ref&lt;/sub&gt;));    L = CenterSlots[W&lt;sub&gt;out&lt;/sub&gt; Attention(Q&lt;sub&gt;learned&lt;/sub&gt;, K&lt;sub&gt;visual+2Dpos&lt;/sub&gt;, V&lt;sub&gt;visual−valid mean&lt;/sub&gt;)];    S&lt;sub&gt;ref&lt;/sub&gt; = [g,L] ∈ ℝ&lt;sup&gt;8×32&lt;/sup&gt;." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=22;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1414" width="2752" height="40" as="geometry" />
        </mxCell>
        <mxCell id="explain-3" value="x&lt;sub&gt;style&lt;/sub&gt; = G(S&lt;sub&gt;ref&lt;/sub&gt;, y′);    if y′ = y and the target geometry matches the training reconstruction target, this becomes the reconstruction path." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=22;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1464" width="2752" height="40" as="geometry" />
        </mxCell>
        <mxCell id="explain-4" value="The global branch uses two residual gated DW k7 context blocks with dilations 1 and 2. Local evidence uses three B scales pooled to four height rows, projected to 256 channels, and queried by seven orthogonally initialized learned slots with four attention heads. Positions address evidence through K; they are not added to appearance V." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1514" width="2752" height="64" as="geometry" />
        </mxCell>
        <mxCell id="explain-5" value="Configured GAN sampling/evaluation uses EMA G/E (beta 0.9998) and fixed pretrained B. W, R, D and P are unnecessary for generation. FID/KID/HWD are downstream measurements, not inputs to this graph or objectives backpropagated during evaluation." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1588" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="explain-6" value="Shared notation: x_ref = original reference geometry; x = canonical real reconstruction target; y = its transcript; y′ = requested text; w = training writer ID. The diagrams summarize normal gan_iam_32/64 configurations, not MAIN’s separate token-capacity experiment." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1635" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="source" value="ALPHA · 7eed74c6b2 · 2026-10-15 · Reference and random priors are distinct style sources; nested mini-diagrams share the same model parameters." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1920" width="2752" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
