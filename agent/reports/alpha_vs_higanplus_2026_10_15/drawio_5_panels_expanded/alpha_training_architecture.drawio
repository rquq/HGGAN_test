        </mxCell>
        <mxCell id="legend" value="C1: global/local E   ·   C2: content-first fusion   ·   C3: StrokePatchD/crops   |   Solid: forward   ·   Dashed: loss/target   ·   Green: global-style conditioning" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1272" width="2752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="explain-0" value="Random-style forward pass" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#202020;">
          <mxGeometry x="64" y="1320" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="explain-1" value="Text establishes spatial content before local style is injected. The same style layout is used by random and reference-guided generation: one global token for block-wide conditioning and seven centered local tokens for spatial appearance. No character-specific fallback or single-digit switch is used." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1367" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="explain-2" value="z&lt;sub&gt;g&lt;/sub&gt; ∼ N(0, I&lt;sub&gt;32&lt;/sub&gt;);    Z&lt;sub&gt;L&lt;/sub&gt; ∼ N(0, I) with shape 7 × 32;    L&lt;sub&gt;j&lt;/sub&gt; = Z&lt;sub&gt;L,j&lt;/sub&gt; − (1/7) ∑&lt;sub&gt;k&lt;/sub&gt; Z&lt;sub&gt;L,k&lt;/sub&gt;;    x&lt;sub&gt;rand&lt;/sub&gt; = G([z&lt;sub&gt;g&lt;/sub&gt;,L], y′)." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=22;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1414" width="2752" height="40" as="geometry" />
        </mxCell>
        <mxCell id="explain-3" value="Spatial refinement: Q = W&lt;sub&gt;Q&lt;/sub&gt; LN(F);    K = W&lt;sub&gt;K&lt;/sub&gt; LN(L);    V = W&lt;sub&gt;V&lt;/sub&gt; L;    F&lt;sub&gt;out&lt;/sub&gt; = F + α ⊙ W&lt;sub&gt;O&lt;/sub&gt; Attention(Q,K,V)." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=22;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1464" width="2752" height="40" as="geometry" />
        </mxCell>
        <mxCell id="explain-4" value="Content attention and spatial style attention each use 4 heads and attention width 128. Spatial style refinement happens once after the first GBlock. α is learned per feature channel (initialized at 0.25), not a hardcoded character gate." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1514" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="explain-5" value="Both native heights retain four GBlocks (512→256→128→64→64 channels). Feature heights are 4→8→16→32→32 at H32, or 4→8→16→32→64 at H64. The final stage refines at constant resolution or upsamples according to requested geometry." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1561" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="explain-6" value="T = valid target character count;    output width = 16T at H32 or 32T at H64.    Inference: no loss, backward pass or critic optimizer step." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=22;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1608" width="2752" height="40" as="geometry" />
        </mxCell>
        <mxCell id="source" value="ALPHA · 7eed74c6b2 · 2026-10-15 · Reference and random priors are distinct style sources; nested mini-diagrams share the same model parameters." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1920" width="2752" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
