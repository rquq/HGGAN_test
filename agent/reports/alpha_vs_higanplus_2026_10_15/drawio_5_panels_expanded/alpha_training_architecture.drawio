        <mxCell id="out" value="&lt;b&gt;Styled output&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;x_style = G(S_ref, y′)&lt;br&gt;Reference writer appearance&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#202020;strokeWidth=1.2;fontColor=#202020;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=10;overflow=hidden;">
