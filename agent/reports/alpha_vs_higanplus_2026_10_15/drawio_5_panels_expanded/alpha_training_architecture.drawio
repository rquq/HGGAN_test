        <mxCell id="outer-edge-4" edge="1" parent="edges" source="text" target="g-port-4-target" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=8;strokeColor=#202020;strokeWidth=1.4;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;">
