        <mxCell id="title" value="(c) Refining local patches and reference appearance" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#202020;">
          <mxGeometry x="64" y="28" width="2752" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A complete real/reference → G → generated-image → StrokePatchD/contextual flow; no separate texture generator is present" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="88" width="2752" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="C1: global/local E   ·   C2: content-first fusion   ·   C3: StrokePatchD/crops   |   Solid: forward   ·   Dashed: loss/target   ·   Green: global-style conditioning" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1272" width="2752" height="28" as="geometry" />
        </mxCell>
        <mxCell id="explain-0" value="One crop policy; two complementary supervision signals" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=21;fontStyle=1;fontColor=#202020;">
          <mxGeometry x="64" y="1320" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="explain-1" value="Crop side s = H/2 (16 at H32, 32 at H64). Horizontal start positions are stratified; vertical locations alternate upper/lower halves. Real and all fake branches use the same policy, not identical coordinates. Only P receives these crops; global D always receives complete words." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1367" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="explain-2" value="K&lt;sub&gt;n&lt;/sub&gt; = clamp(ceil(W&lt;sub&gt;n&lt;/sub&gt; / (H/2)), 4, 8);    L&lt;sub&gt;P&lt;/sub&gt; = HingeMap(P(C(x)), +1) + (1/3) ∑&lt;sub&gt;b&lt;/sub&gt; HingeMap(P(C(stop(x&lt;sub&gt;b&lt;/sub&gt;))), −1)." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=22;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1414" width="2752" height="40" as="geometry" />
        </mxCell>
        <mxCell id="explain-3" value="L&lt;sub&gt;adv,P&lt;/sub&gt; = −(1/3) ∑&lt;sub&gt;b&lt;/sub&gt; MeanWord[MeanCrop[MeanMap[P(C(x&lt;sub&gt;b&lt;/sub&gt;))]]];    generator contribution = 0.45 L&lt;sub&gt;adv,P&lt;/sub&gt;." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=22;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1464" width="2752" height="40" as="geometry" />
        </mxCell>
        <mxCell id="explain-4" value="L&lt;sub&gt;ctx&lt;/sub&gt; = ∑&lt;sub&gt;l&lt;/sub&gt; CX(stop(B&lt;sub&gt;l&lt;/sub&gt;(x&lt;sub&gt;ref&lt;/sub&gt;)), B&lt;sub&gt;l&lt;/sub&gt;(x&lt;sub&gt;style&lt;/sub&gt;));    generator contribution = 0.1 L&lt;sub&gt;ctx&lt;/sub&gt;;    l ∈ {three selected backbone scales}." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=22;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1514" width="2752" height="40" as="geometry" />
        </mxCell>
        <mxCell id="explain-5" value="P: 3×3 stem (1→64) → three residual StrokePatchBlocks (128→192→192; 3×3 plus axial DW 1×5 / 5×1 and 1×1 fusion) → spatial logit head. Pooling preserves a minimum 4×4 grid. Hinge is applied BEFORE map/crop reduction, then each word and fake branch is weighted equally." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1564" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="explain-6" value="CTX matches non-aligned multiscale writer features to new text, with at most 256 sampled spatial features per comparison. Cached B maps are reused. The context comparison is not a reconstruction pixel target, frequency loss, foreground mask or independent texture-refinement network." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1611" width="2752" height="37" as="geometry" />
        </mxCell>
        <mxCell id="source" value="ALPHA · 7eed74c6b2 · 2026-10-15 · Reference and random priors are distinct style sources; nested mini-diagrams share the same model parameters." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=13;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1920" width="2752" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
