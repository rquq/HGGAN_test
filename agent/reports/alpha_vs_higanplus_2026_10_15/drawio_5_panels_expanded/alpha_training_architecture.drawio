        </mxCell>
        <mxCell id="subtitle" value="No reference image is needed · only the Generator and a sampled style prior are required at inference" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#202020;">
