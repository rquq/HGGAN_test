        <mxCell id="train" value="&lt;b&gt;TRAINABLE vs FROZEN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Dashed module border = frozen parameters in that phase.&lt;br&gt;Frozen modules can still transmit gradients to generated pixels.&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f7f3e9;strokeColor=#263746;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
