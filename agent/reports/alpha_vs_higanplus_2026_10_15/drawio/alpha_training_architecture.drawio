        <mxCell id="note-1" value="P receives no writer/text labels. It learns local realism from adversarial real-vs-fake supervision, not predefined stroke classes." vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526171;fontStyle=0;spacing=0;">
