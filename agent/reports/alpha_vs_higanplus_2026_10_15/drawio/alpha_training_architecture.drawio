        <mxCell id="lp" value="&lt;b&gt;Critic: L_P = Hinge(P(real), +1) + mean_b Hinge(P(fake_b), −1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Train P; fake tensors detached. Hinge is applied per logit BEFORE spatial and crop averaging.&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2d6;strokeColor=#263746;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="80" y="716" width="684" height="104" as="geometry" />
        </mxCell>
        <mxCell id="lgp" value="&lt;b&gt;Generator: L_adv,P = −mean_b mean_word P(fake_b)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Freeze P; preserve input gradients. Generator weight λ_patch_adv = 0.45.&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2d6;strokeColor=#263746;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="824" y="716" width="696" height="104" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Local stroke critic: sampling, comparison and network" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=32;fontColor=#263746;fontStyle=1;spacing=0;">
          <mxGeometry x="64" y="28" width="1472" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One policy for real and all three fake branches · patch logits are supervised before spatial/crop reductions" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="84" width="1472" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="Independent coordinates are drawn for each image; “same policy” does not mean pixel-aligned real/fake crops." vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526171;fontStyle=0;spacing=0;">
