        <mxCell id="note-1" value="The probe learns to recover content; gradient reversal trains the global encoder code to hide it. No extra OCR loss is applied to x_rec." vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526171;fontStyle=0;spacing=0;">
