        <mxCell id="note-0" value="GBlock stages: H=8 → 16 → 32 → (32 or 64). Output width is 16T at H32 and 32T at H64; padding is not a foreground mask." vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526171;fontStyle=0;spacing=0;">
