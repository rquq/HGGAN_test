        <mxCell id="title" value="Content-first generation with two distinct style routes" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=32;fontColor=#263746;fontStyle=1;spacing=0;">
