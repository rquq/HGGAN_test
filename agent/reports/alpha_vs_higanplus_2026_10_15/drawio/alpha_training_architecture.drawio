        <mxCell id="note-0" value="Reconstruction also receives both adversarial losses (pages 03/04). Pixel weight decays 10 → 2.5 over epochs 24–42." vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526171;fontStyle=0;spacing=0;">
