        </mxCell>
        <mxCell id="flow" value="&lt;b&gt;Solid vs dashed arrows&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Solid: forward tensor or measured prediction.&lt;br&gt;Dashed brown: target, detached target, initialization, or optimizer action.&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2d6;strokeColor=#263746;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
