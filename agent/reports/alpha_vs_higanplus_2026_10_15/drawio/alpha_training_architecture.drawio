        <mxCell id="notation" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;x_ref: original reference geometry · x: canonical reconstruction target&lt;br&gt;y: reference transcript · y′: sampled target text · w: writer ID&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f1f3f5;strokeColor=#263746;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
