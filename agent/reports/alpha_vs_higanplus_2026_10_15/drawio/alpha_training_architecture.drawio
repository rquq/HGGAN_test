        </mxCell>
        <mxCell id="styles" value="&lt;b&gt;Style representation S = [g, L]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;g: 1 global token, 32-D · L: 7 local tokens, 7 × 32-D&lt;br&gt;Prior z has the same layout; local slots are centered.&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f3ee;strokeColor=#263746;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
