        <mxCell id="note-1" value="Local attention is applied ONCE after GBlock 1. No Mamba, allograph-ID gate, texture generator, or frequency loss is active here." vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526171;fontStyle=0;spacing=0;">
