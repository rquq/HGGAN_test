        <mxCell id="prior" value="&lt;b style=&quot;font-size:19px&quot;&gt;Random prior z&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;1 global + 7 locals&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ded6e9;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
