        <mxCell id="paper-panel" value="" vertex="1" parent="zones" style="rounded=0;html=1;fillColor=#e3f0f3;strokeColor=none;pointerEvents=0;">
          <mxGeometry x="48" y="124" width="1504" height="744" as="geometry" />
