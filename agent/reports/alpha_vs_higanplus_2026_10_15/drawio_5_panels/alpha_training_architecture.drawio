        </mxCell>
        <mxCell id="edge-4" value="" edge="1" parent="edges" source="g" target="out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#263746;jumpStyle=arc;jumpSize=8;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1188" y="480.0" />
              <mxPoint x="1188" y="488.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="text" value="&lt;b style=&quot;font-size:19px&quot;&gt;Target text y′&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Supported character sequence&lt;br&gt;Example: “there”&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="64" y="272" width="224" height="112" as="geometry" />
        </mxCell>
        <mxCell id="content" value="&lt;b style=&quot;font-size:19px&quot;&gt;Text representation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;120-D embedding per character&lt;br&gt;Relative-position self-attention&lt;br&gt;Gated local FFN, DW k5&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1dddd;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="344" y="272" width="264" height="144" as="geometry" />
        </mxCell>
        <mxCell id="prior" value="&lt;b style=&quot;font-size:19px&quot;&gt;Sample N(0,I)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;z_g: 1 × 32&lt;br&gt;z_L: 7 × 32&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ded6e9;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="64" y="544" width="224" height="144" as="geometry" />
        </mxCell>
        <mxCell id="pack" value="&lt;b style=&quot;font-size:19px&quot;&gt;Style z = [z_g, L]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;L_j = z_L,j − mean_k z_L,k&lt;br&gt;Center over the 7 local slots&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ded6e9;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="344" y="544" width="264" height="144" as="geometry" />
        </mxCell>
        <mxCell id="g" value="&lt;b style=&quot;font-size:28px&quot;&gt;G&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Content-only spatial seed: 512 × 4 × (4T)&lt;br&gt;&lt;br&gt;Global z_g → four block-specific style MLPs → CBN&lt;br&gt;&lt;br&gt;GBlock 1 → spatial style attention(Q=features, K/V=locals)&lt;br&gt;→ GBlocks 2–4 → BN / convolution / tanh&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1dddd;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="688" y="272" width="456" height="416" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b style=&quot;font-size:19px&quot;&gt;Generated image x_rand&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;H × (character_width × T)&lt;br&gt;No D, P, R or writer classifier&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="1208" y="416" width="328" height="144" as="geometry" />
        </mxCell>
        <mxCell id="title" value="(d) Testing with random styles" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#263746;fontStyle=1;spacing=0;">
          <mxGeometry x="64" y="28" width="1472" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="No reference image is needed · only the Generator and a sampled style prior are required at inference" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="84" width="1472" height="40" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="ALPHA · 7eed74c6b2 · networks/model.py / module.py / fusion.py / BigGAN_networks.py · 2026-10-15" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="1440" width="1472" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Solid = forward tensors     Dashed orange = loss / target dependency     Dashed module border = frozen parameters in the depicted phase" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="880" width="1472" height="20" as="geometry" />
        </mxCell>
        <mxCell id="explanation-0" value="Random-style forward pass" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#202020;">
          <mxGeometry x="64" y="916" width="1472" height="34" as="geometry" />
        </mxCell>
        <mxCell id="explanation-1" value="Text establishes spatial content before local style is injected. The same style layout is used by random and reference-guided generation: one global token for block-wide conditioning and seven centered local tokens for spatial appearance. No character-specific fallback or single-digit switch is used." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="958" width="1472" height="54" as="geometry" />
        </mxCell>
        <mxCell id="explanation-2" value="z&lt;sub&gt;g&lt;/sub&gt; ∼ N(0, I&lt;sub&gt;32&lt;/sub&gt;);    Z&lt;sub&gt;L&lt;/sub&gt; ∼ N(0, I) with shape 7 × 32;    L&lt;sub&gt;j&lt;/sub&gt; = Z&lt;sub&gt;L,j&lt;/sub&gt; − (1/7) ∑&lt;sub&gt;k&lt;/sub&gt; Z&lt;sub&gt;L,k&lt;/sub&gt;;    x&lt;sub&gt;rand&lt;/sub&gt; = G([z&lt;sub&gt;g&lt;/sub&gt;,L], y′)." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1020" width="1472" height="35" as="geometry" />
        </mxCell>
        <mxCell id="explanation-3" value="Spatial refinement: Q = W&lt;sub&gt;Q&lt;/sub&gt; LN(F);    K = W&lt;sub&gt;K&lt;/sub&gt; LN(L);    V = W&lt;sub&gt;V&lt;/sub&gt; L;    F&lt;sub&gt;out&lt;/sub&gt; = F + α ⊙ W&lt;sub&gt;O&lt;/sub&gt; Attention(Q,K,V)." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1063" width="1472" height="35" as="geometry" />
        </mxCell>
        <mxCell id="explanation-4" value="Content attention and spatial style attention each use 4 heads and attention width 128. Spatial style refinement happens once after the first GBlock. α is learned per feature channel (initialized at 0.25), not a hardcoded character gate." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1106" width="1472" height="54" as="geometry" />
        </mxCell>
        <mxCell id="explanation-5" value="Both native heights retain four GBlocks (512→256→128→64→64 channels). Feature heights are 4→8→16→32→32 at H32, or 4→8→16→32→64 at H64. The final stage refines at constant resolution or upsamples according to requested geometry." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1168" width="1472" height="54" as="geometry" />
        </mxCell>
        <mxCell id="explanation-6" value="T = valid target character count;    output width = 16T at H32 or 32T at H64.    Inference: no loss, backward pass or critic optimizer step." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1230" width="1472" height="35" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="e" name="(e) Reference-style inference">
    <mxGraphModel dx="1600" dy="1480" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1480" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="zones" parent="0" value="Panel boundaries" />
        <mxCell id="edges" parent="0" value="Forward and objective connections" />
        <mxCell id="1" parent="0" value="Editable modules" />
