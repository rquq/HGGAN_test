        <mxCell id="real" value="&lt;b style=&quot;font-size:19px&quot;&gt;Real image x&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Canonical valid-width image&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="608" y="184" width="264" height="104" as="geometry" />
        </mxCell>
        <mxCell id="crop_r" value="&lt;b style=&quot;font-size:19px&quot;&gt;Stratified crops&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;s = H/2; K = ceil(W/s)&lt;br&gt;K clamped to [4,8]&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="928" y="184" width="216" height="112" as="geometry" />
        </mxCell>
        <mxCell id="crop_f" value="&lt;b style=&quot;font-size:19px&quot;&gt;Same crop policy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;All 3 fake branches&lt;br&gt;Independent coordinates&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="1200" y="400" width="176" height="136" as="geometry" />
        </mxCell>
        <mxCell id="p" value="&lt;b style=&quot;font-size:28px&quot;&gt;P&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;StrokePatchD&lt;br&gt;Spatial patch logits&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1dddd;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="1200" y="184" width="176" height="112" as="geometry" />
        </mxCell>
        <mxCell id="adv" value="&lt;b style=&quot;font-size:19px&quot;&gt;Adv_P&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Patch hinge&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffead7;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="1432" y="192" width="104" height="96" as="geometry" />
        </mxCell>
        <mxCell id="bf" value="&lt;b style=&quot;font-size:28px&quot;&gt;B&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Frozen multiscale features&lt;br&gt;x_style only&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1dddd;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;dashed=1;dashPattern=5 3;">
          <mxGeometry x="928" y="704" width="216" height="112" as="geometry" />
        </mxCell>
        <mxCell id="ctx" value="&lt;b style=&quot;font-size:19px&quot;&gt;CTX&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Fake B maps vs&lt;br&gt;stop(reference B maps)&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffead7;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="1200" y="704" width="176" height="112" as="geometry" />
        </mxCell>
        <mxCell id="title" value="(c) Refining local patches and reference appearance" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#263746;fontStyle=1;spacing=0;">
          <mxGeometry x="64" y="28" width="1472" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="A complete real/reference → G → generated-image → StrokePatchD/contextual flow; no separate texture generator is present" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="84" width="1472" height="40" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="ALPHA · 7eed74c6b2 · networks/model.py / module.py / fusion.py / BigGAN_networks.py · 2026-10-15" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="1440" width="1472" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Solid = forward tensors     Dashed orange = loss / target dependency     Dashed module border = frozen parameters in the depicted phase" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="880" width="1472" height="20" as="geometry" />
        </mxCell>
        <mxCell id="explanation-0" value="One crop policy; two complementary supervision signals" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#202020;">
          <mxGeometry x="64" y="916" width="1472" height="34" as="geometry" />
        </mxCell>
        <mxCell id="explanation-1" value="Crop side s = H/2 (16 at H32, 32 at H64). Horizontal start positions are stratified; vertical locations alternate upper/lower halves. Real and all fake branches use the same policy, not identical coordinates. Only P receives these crops; global D always receives complete words." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="958" width="1472" height="54" as="geometry" />
        </mxCell>
        <mxCell id="explanation-2" value="K&lt;sub&gt;n&lt;/sub&gt; = clamp(ceil(W&lt;sub&gt;n&lt;/sub&gt; / (H/2)), 4, 8);    L&lt;sub&gt;P&lt;/sub&gt; = HingeMap(P(C(x)), +1) + (1/3) ∑&lt;sub&gt;b&lt;/sub&gt; HingeMap(P(C(stop(x&lt;sub&gt;b&lt;/sub&gt;))), −1)." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1020" width="1472" height="35" as="geometry" />
        </mxCell>
        <mxCell id="explanation-3" value="L&lt;sub&gt;adv,P&lt;/sub&gt; = −(1/3) ∑&lt;sub&gt;b&lt;/sub&gt; MeanWord[MeanCrop[MeanMap[P(C(x&lt;sub&gt;b&lt;/sub&gt;))]]];    generator contribution = 0.45 L&lt;sub&gt;adv,P&lt;/sub&gt;." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1063" width="1472" height="35" as="geometry" />
        </mxCell>
        <mxCell id="explanation-4" value="L&lt;sub&gt;ctx&lt;/sub&gt; = ∑&lt;sub&gt;l&lt;/sub&gt; CX(stop(B&lt;sub&gt;l&lt;/sub&gt;(x&lt;sub&gt;ref&lt;/sub&gt;)), B&lt;sub&gt;l&lt;/sub&gt;(x&lt;sub&gt;style&lt;/sub&gt;));    generator contribution = 0.1 L&lt;sub&gt;ctx&lt;/sub&gt;;    l ∈ {three selected backbone scales}." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1106" width="1472" height="35" as="geometry" />
        </mxCell>
        <mxCell id="explanation-5" value="P: 3×3 stem (1→64) → three residual StrokePatchBlocks (128→192→192; 3×3 plus axial DW 1×5 / 5×1 and 1×1 fusion) → spatial logit head. Pooling preserves a minimum 4×4 grid. Hinge is applied BEFORE map/crop reduction, then each word and fake branch is weighted equally." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1149" width="1472" height="54" as="geometry" />
        </mxCell>
        <mxCell id="explanation-6" value="CTX matches non-aligned multiscale writer features to new text, with at most 256 sampled spatial features per comparison. Cached B maps are reused. The context comparison is not a reconstruction pixel target, frequency loss, foreground mask or independent texture-refinement network." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1211" width="1472" height="54" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d" name="(d) Random-style inference">
    <mxGraphModel dx="1600" dy="1480" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1480" background="#ffffff" math="0" shadow="0">
