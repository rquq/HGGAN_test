        <mxCell id="ref" value="&lt;b style=&quot;font-size:19px&quot;&gt;Style reference&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;x_ref + valid width&lt;br&gt;Any supported word image&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="64" y="420" width="184" height="144" as="geometry" />
        </mxCell>
        <mxCell id="b" value="&lt;b style=&quot;font-size:28px&quot;&gt;B&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Pretrained residual backbone&lt;br&gt;3 scales: 64 / 128 / 256&lt;br&gt;Frozen feature extractor&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1dddd;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;dashed=1;dashPattern=5 3;">
          <mxGeometry x="304" y="420" width="216" height="144" as="geometry" />
        </mxCell>
        <mxCell id="e" value="&lt;b style=&quot;font-size:28px&quot;&gt;E&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Global: two gated context blocks&lt;br&gt;→ valid mean / LN / MLP → mu_g&lt;br&gt;&lt;br&gt;Local: multiscale 4-row evidence&lt;br&gt;→ 7 learned-query cross-attention slots&lt;br&gt;→ 32-D projection + slot centering&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1dddd;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="576" y="372" width="328" height="240" as="geometry" />
        </mxCell>
        <mxCell id="g" value="&lt;b style=&quot;font-size:28px&quot;&gt;G&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Target text → content context / seed&lt;br&gt;Global g → block-specific CBN&lt;br&gt;Local L → spatial style attention&lt;br&gt;4 residual image stages → tanh&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1dddd;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="968" y="372" width="320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="text" value="&lt;b style=&quot;font-size:19px&quot;&gt;Target text y′&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;New content, independent of reference text&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="968" y="184" width="320" height="104" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b style=&quot;font-size:19px&quot;&gt;Styled output&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;x_style = G(S_ref, y′)&lt;br&gt;Reference writer appearance&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="1352" y="420" width="184" height="144" as="geometry" />
        </mxCell>
        <mxCell id="title" value="(e) Testing with reference-guided styles" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#263746;fontStyle=1;spacing=0;">
          <mxGeometry x="64" y="28" width="1472" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Reference image → pretrained B → learned E → G → generated word · the target transcript need not match the reference transcript" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="84" width="1472" height="40" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="ALPHA · 7eed74c6b2 · networks/model.py / module.py / fusion.py / BigGAN_networks.py · 2026-10-15" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="1440" width="1472" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Solid = forward tensors     Dashed orange = loss / target dependency     Dashed module border = frozen parameters in the depicted phase" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="880" width="1472" height="20" as="geometry" />
        </mxCell>
        <mxCell id="explanation-0" value="A learned global/local representation, not a reference-length rule" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#202020;">
          <mxGeometry x="64" y="916" width="1472" height="34" as="geometry" />
        </mxCell>
        <mxCell id="explanation-1" value="B supplies multiscale visual evidence. E separates global pooled style from local residual evidence. During deterministic evaluation, g = mu_g; the seven local tokens are always deterministic. Reference text labels and writer IDs are not inputs to this inference path." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="958" width="1472" height="54" as="geometry" />
        </mxCell>
        <mxCell id="explanation-2" value="g = μ&lt;sub&gt;g&lt;/sub&gt;(B(x&lt;sub&gt;ref&lt;/sub&gt;));    L = CenterSlots[W&lt;sub&gt;out&lt;/sub&gt; Attention(Q&lt;sub&gt;learned&lt;/sub&gt;, K&lt;sub&gt;visual+2Dpos&lt;/sub&gt;, V&lt;sub&gt;visual−valid mean&lt;/sub&gt;)];    S&lt;sub&gt;ref&lt;/sub&gt; = [g,L] ∈ ℝ&lt;sup&gt;8×32&lt;/sup&gt;." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1020" width="1472" height="35" as="geometry" />
        </mxCell>
        <mxCell id="explanation-3" value="x&lt;sub&gt;style&lt;/sub&gt; = G(S&lt;sub&gt;ref&lt;/sub&gt;, y′);    if y′ = y and the target geometry matches the training reconstruction target, this becomes the reconstruction path." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1063" width="1472" height="35" as="geometry" />
        </mxCell>
        <mxCell id="explanation-4" value="The global branch uses two residual gated DW k7 context blocks with dilations 1 and 2. Local evidence uses three B scales pooled to four height rows, projected to 256 channels, and queried by seven orthogonally initialized learned slots with four attention heads. Positions address evidence through K; they are not added to appearance V." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1106" width="1472" height="54" as="geometry" />
        </mxCell>
        <mxCell id="explanation-5" value="Configured GAN sampling/evaluation uses EMA G/E (beta 0.9998) and fixed pretrained B. W, R, D and P are unnecessary for generation. FID/KID/HWD are downstream measurements, not inputs to this graph or objectives backpropagated during evaluation." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1168" width="1472" height="54" as="geometry" />
        </mxCell>
        <mxCell id="explanation-6" value="Shared notation: x_ref = original reference geometry; x = canonical real reconstruction target; y = its transcript; y′ = requested text; w = training writer ID. The diagrams summarize normal gan_iam_32/64 configurations, not MAIN’s separate token-capacity experiment." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1230" width="1472" height="54" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>