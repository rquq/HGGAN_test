          <mxGeometry x="1416" y="428" width="120" height="88" as="geometry" />
        </mxCell>
        <mxCell id="eg2" value="&lt;b style=&quot;font-size:19px&quot;&gt;B → E_g&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Global-only E&lt;br&gt;Same B / E weights&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f1dddd;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="1184" y="660" width="184" height="88" as="geometry" />
        </mxCell>
        <mxCell id="info" value="&lt;b style=&quot;font-size:19px&quot;&gt;L1_info&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;vs stop(z_g)&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffead7;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="1416" y="660" width="120" height="88" as="geometry" />
        </mxCell>
        <mxCell id="kl" value="&lt;b style=&quot;font-size:19px&quot;&gt;KL&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;Global posterior vs N(0,I)&lt;br&gt;No local posterior penalty&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffead7;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="304" y="184" width="248" height="104" as="geometry" />
        </mxCell>
        <mxCell id="content" value="&lt;b style=&quot;font-size:19px&quot;&gt;Content BCE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px;line-height:1.25&quot;&gt;GRL → learned probe&lt;br&gt;vs bag of characters in y&lt;/span&gt;" vertex="1" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#ffead7;strokeColor=#202020;strokeWidth=1.3;fontColor=#263746;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=8;overflow=hidden;">
          <mxGeometry x="64" y="184" width="184" height="112" as="geometry" />
        </mxCell>
        <mxCell id="title" value="(b) Regularization with reconstruction" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#263746;fontStyle=1;spacing=0;">
          <mxGeometry x="64" y="28" width="1472" height="48" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Image reconstruction and two global-code recovery paths share G/E; the local tokens are deterministic and have no KL term" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="84" width="1472" height="40" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="ALPHA · 7eed74c6b2 · networks/model.py / module.py / fusion.py / BigGAN_networks.py · 2026-10-15" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="1440" width="1472" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Solid = forward tensors     Dashed orange = loss / target dependency     Dashed module border = frozen parameters in the depicted phase" vertex="1" parent="notes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526171;fontStyle=0;spacing=0;">
          <mxGeometry x="64" y="880" width="1472" height="20" as="geometry" />
        </mxCell>
        <mxCell id="explanation-0" value="What is reconstructed — and what is not" vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=19;fontStyle=1;fontColor=#202020;">
          <mxGeometry x="64" y="916" width="1472" height="34" as="geometry" />
        </mxCell>
        <mxCell id="explanation-1" value="Pixel L1 compares x_rec to the canonical real image x over valid pixels, not to the original-width style reference. Global information recovery reconstructs the prior z_g; transfer cycle recovers the reference global mean. These are separate targets, not three copies of one loss." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="958" width="1472" height="54" as="geometry" />
        </mxCell>
        <mxCell id="explanation-2" value="L&lt;sub&gt;rec&lt;/sub&gt; = mean&lt;sub&gt;valid&lt;/sub&gt; |x&lt;sub&gt;rec&lt;/sub&gt; − x|;    L&lt;sub&gt;info&lt;/sub&gt; = mean |E&lt;sub&gt;g&lt;/sub&gt;(B(x&lt;sub&gt;rand&lt;/sub&gt;)) − stop(z&lt;sub&gt;g&lt;/sub&gt;)| / 8;    L&lt;sub&gt;cycle&lt;/sub&gt; = mean |E&lt;sub&gt;g&lt;/sub&gt;(B(x&lt;sub&gt;style&lt;/sub&gt;)) − stop(μ&lt;sub&gt;g,ref&lt;/sub&gt;)| / 8." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1020" width="1472" height="35" as="geometry" />
        </mxCell>
        <mxCell id="explanation-3" value="L&lt;sub&gt;KL&lt;/sub&gt; = KL[N(μ&lt;sub&gt;g&lt;/sub&gt;, diag(exp(ℓ&lt;sub&gt;g&lt;/sub&gt;))) || N(0,I)] / 8;    g = μ&lt;sub&gt;g&lt;/sub&gt; + exp(0.5 ℓ&lt;sub&gt;g&lt;/sub&gt;) ⊙ ε;    ε ∼ N(0,I);    ℓ&lt;sub&gt;g&lt;/sub&gt; = log σ&lt;sub&gt;g&lt;/sub&gt;²." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1063" width="1472" height="35" as="geometry" />
        </mxCell>
        <mxCell id="explanation-4" value="L&lt;sub&gt;content&lt;/sub&gt; = balanced-BCE(Probe(GRL(μ&lt;sub&gt;g,ref&lt;/sub&gt;)), bag(y)) / 8;    GRL is identity forward and reverses only the gradient toward E." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Times New Roman;fontSize=19;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1106" width="1472" height="35" as="geometry" />
        </mxCell>
        <mxCell id="explanation-5" value="The probe learns reference character presence while E is pushed to hide it in g. Local L is a deterministic, centered 7-token residual; it is neither KL-regularized nor reconstructed against random local slots. E_g skips local retrieval. All repeated B/E/G blocks share weights." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1149" width="1472" height="54" as="geometry" />
        </mxCell>
        <mxCell id="explanation-6" value="These three generated branches also receive the global and patch adversarial losses in (a)/(c). Only x_rand and x_style receive OCR CTC. The /8 factors preserve the explicit eight-token normalization implemented in the current loss functions." vertex="1" parent="notes" style="text;html=1;whiteSpace=wrap;overflow=hidden;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=16;fontStyle=0;fontColor=#202020;">
          <mxGeometry x="64" y="1211" width="1472" height="54" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
