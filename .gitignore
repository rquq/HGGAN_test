# =======================================================
# 1. Python & Environments
# =======================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env
.venv

# =======================================================
# 3. Training Logs & Caches
# =======================================================
runs/
wandb/
lightning_logs/
*.log
checkpoint/
checkpoints/
.cache/

# Kill Hugging Face cache completely
pretrained/hf_cache/
pretrained/hf_cache/*
pretrained/hf_cache/**
pretrained/HWD/
pretrained/HWD/*
pretrained/HWD/**

# =======================================================
# 4. Data, Datasets, and Samples
# =======================================================
data/iam/
data/image_samples/
backup/

# Ignore heavy dataset archives
*.csv
*.tsv
*.zip
*.tar.gz
*.tgz

# =======================================================
# 5. IDEs, Notebooks & OS
# =======================================================
# The ** ensures it ignores these folders even if they are deep inside subfolders
**/.ipynb_checkpoints/
**/.vscode/
**/.idea/

# Distribution / builds
dist/
build/
*.egg-info/

# OS Specific
.DS_Store
Thumbs.db
.directory
*~

# AI-agent local verification artifacts (never commit generated test runners,
# smoke/invariant tests, or their caches). The project's root test.py remains tracked.
/tests/
/.pytest_cache/
